using fn.*

wrapper {
    md: { prefix: "" suffix: "" }
    html: { prefix: "" suffix: "" }

    content: switch {
        value: process.env { "FMT" }

        "html" string.join {
            @root.html.prefix
            string.join { @root.__content__ separator: "" }
            @root.html.suffix

            separator: ""
        }

        string.join {
            @root.md.prefix
            string.join { @root.__content__ separator: "" }
            @root.md.suffix

            separator: ""
        }
    }
}