***
Exon preprocessor.

Check commented section in ./test.js.

Executing preprocessor:
  ./ts-run.sh -r samples/preprocessor/main.run.exon
***

using fn.*

sequence {
    files: [ "test.js" ]

    foreach {
        data: @root.files
        do: sequence {
            path.absolute@filepath {
                parameter{}
            }

            assert {
                path.isfile { @filepath }
                message: "Invalid file"
            }

            // preprocess file and store new content
            fn.preprocess@new_content { file: @filepath }

            // print new content to console
            println {  @new_content }

            // update the given file with the new content
            file.save { path: @filepath data: @new_content }
        }
    }
}