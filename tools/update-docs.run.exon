***
update-docs.run.exon

Finds every .md file under docs/ and rewrites it in-place,
evaluating HTML-style preprocessor regions:

  <!--#exon-->
  <!--
      fn.string.join { "generated content" }
  -->
  old generated content
  <!--#endexon-->

Usage (from runtimes/typescript/):
  node bin/main.js ../../tools/update-docs.run.exon
***

using fn.*

sequence {
    closure@updateDocuments {
        rootDir: string.trim { process.exec { "git rev-parse --show-toplevel" } }

        sequence {
            parameter@extension{"extension"}

            string.split@files {
                string.trim {
                    process.exec { "find " @rootDir parameter{"folder"} " -name '*." @extension "'" }
                }
                separator: "\n"
            }

            foreach {
                data: @files
                do: sequence {
                    parameter@filepath{}

                    preprocess@updated {
                        file:  @filepath
                        style: "html"
                        argv: [ string.join { "fmt=" @extension } ]
                    }

                    file.save { path: @filepath data: @updated }
                    println { "updated: " @filepath }
                }
            }
        } 
    }

    call { @updateDocuments  folder: "/docs" extension: "md" }

    call { @updateDocuments  folder: "/site" extension: "html" }

    process.exec { "cp docs/markdown/README.md README.md" }
}
