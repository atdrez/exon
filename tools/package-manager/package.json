{
  "name": "exon-package-manager",
  "version": "0.4.0",
  "description": "Package manager for exon projects: installs dependencies declared in exon-package.json",
  "license": "MIT",
  "main": "bin/main.js",
  "bin": {
    "expm": "./expm.js"
  },
  "files": [
    "bin/**/*.js",
    "bin/**/*.js.map",
    "expm.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atdrez/exon.git",
    "directory": "tools/package-manager"
  },
  "homepage": "https://github.com/atdrez/exon#readme",
  "bugs": {
    "url": "https://github.com/atdrez/exon/issues"
  },
  "keywords": [
    "exon",
    "package-manager",
    "cli"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node bin/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "npm run lint && rm -rf bin && tsc",
    "prepare": "rm -rf bin && tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "exon-runtime": "^0.4.0",
    "tar": "^7.5.20",
    "terser": "^5.49.0"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
