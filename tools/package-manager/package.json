{
  "name": "exon-package-manager",
  "version": "1.0.0",
  "description": "Package manager for exon projects: installs dependencies declared in exon-package.json",
  "license": "MIT",
  "main": "bin/main.js",
  "bin": {
    "expm": "./expm.js"
  },
  "files": [
    "bin/**/*.js",
    "bin/**/*.js.map",
    "expm.js"
  ],
  "scripts": {
    "start": "node bin/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build": "npm run lint && tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "exon-runtime": "file:../../runtimes/typescript",
    "tar": "^7.5.20"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
