    dbF19: basic.models.Database { host: "h19" port: 1019 name: "f19" poolSize: 29 }
    dbF20: basic.models.Database { host: "h20" port: 1020 name: "f20" poolSize: 30 }

    // twenty gauge instances (deferred script with a base of its own -
    // gauge.exon wraps a lib.clamped call)
    gauge01: property.gauge { }
    gauge02: property.gauge { value: 10 }
    gauge03: property.gauge { value: 20 }
    gauge04: property.gauge { value: 30 }
    gauge05: property.gauge { value: 40 }
