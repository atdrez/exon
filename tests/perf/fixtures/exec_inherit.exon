    gauge14: property.gauge { value: 35 }
    gauge15: property.gauge { value: 45 }
    gauge16: property.gauge { value: 55 }
    gauge17: property.gauge { value: 65 }
    gauge18: property.gauge { value: 75 }
    gauge19: property.gauge { value: 85 }
    gauge20: property.gauge { value: 95 }
}
